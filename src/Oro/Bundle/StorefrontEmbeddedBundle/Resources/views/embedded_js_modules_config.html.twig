{% if oro_storefront_embedded_request() %}
    {% import '@OroAsset/Asset.html.twig' as Asset %}

    {% if app.debug and oro_frontend.debug_routes %}
        {% set routes = path('oro_frontend_js_routing_js', {_format: 'json'}) %}
    {% else %}
        {% set routes = asset('media/js/frontend_routes.json', 'routing') %}
    {% endif %}

    {% if app.debug and oro_translation_debug_js_translations() %}
        {% set translations = path('oro_translation_jstranslation') %}
    {% else %}
        {% set translations = asset(asset_path('oro_translation_jstranslation'), 'translations') %}
    {% endif %}

    {% set proxyPrefix = oro_storefront_embedded_proxy_prefix() %}
    {% set routesServedByTheHost = proxyPrefix and routes starts with '/' and not (routes starts with '//') %}
    {% set translationsServedByTheHost =
        proxyPrefix and translations starts with '/' and not (translations starts with '//') %}

    {{ Asset.js_modules_config({
        'oronavigation/js/routes-loader': {
            routesResource: routesServedByTheHost ? proxyPrefix ~ routes : absolute_url(routes)
        },
        'orotranslation/js/translation-loader': {
            translationsResources: translationsServedByTheHost
                ? proxyPrefix ~ translations
                : absolute_url(translations)
        },
        'oroui/js/app/modules/svg-sprite-module': {
            debug: false
        }
    }) }}
{% endif %}
