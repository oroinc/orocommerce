# Configuration for https://github.com/oroinc/phpstan-rules/
trusted_data:
    variables:
        Oro\Bundle\InventoryBundle\Api\InventoryLevelProductQueryModifier:
            applyProductRestriction:
                rootAlias: true
        Oro\Bundle\InventoryBundle\CacheWarmer\EntityConfigRelationsMigration:
            migrate:
                warehouseClass: true
